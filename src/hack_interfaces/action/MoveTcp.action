# Moves the TCP of one arm (left_tcp_link / right_tcp_link) to a pose in `pelvis`.
string arm                 # left | right
geometry_msgs/Pose target
string mode                # direct (joint-space) | linear (straight line in Cartesian space) | ready (arm to the side, off the table and out of the head camera view; target unused) | carry (holding an object: linear up to the target height, then linear across; direct when a leg fails)
float32 pos_tol            # metres, 0 = default 0.01
float32 rot_tol            # radians, 0 = default 0.1
float32 max_time           # seconds of sim time, 0 = default
string contact_object      # optional exact perception track_id, only for a recorded linear_fixed descent
float64[3] contact_center   # freshly associated model centre in pelvis; ignored when contact_object is empty
int64 contact_stamp_ns      # RGB-D exposure in /clock time; contact permission expires after 1.75 s
---
bool success
float32 pos_error
float32 rot_error
string message             # ok | unreachable | timeout | not_implemented
---
float32 pos_error
